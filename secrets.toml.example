# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────
# IRIS — Streamlit Secrets (for Streamlit Community Cloud)
#
# HOW TO USE:
#   LOCAL:  Copy this file to .streamlit/secrets.toml and fill in your
#           keys.  The .gitignore already excludes this file.
#           Alternatively, just use the .env file — both work locally.
#
#   CLOUD:  Do NOT commit this file.  Instead, paste the contents into
#           your app's "Secrets" panel at share.streamlit.io:
#           App → ⋮ → Settings → Secrets → paste → Save
#
# All keys are optional except at least one vision model key
# (GEMINI_API_KEY, GROQ_API_KEY, or OPENROUTER_API_KEY).
# ─────────────────────────────────────────────────────────────────

# ── CORE VISION MODELS (need at least one) ────────────────────
GEMINI_API_KEY      = ""
GROQ_API_KEY        = ""
OPENROUTER_API_KEY  = ""

# ── REVERSE IMAGE SEARCH (both needed together) ───────────────
SERPAPI_KEY         = ""
IMGBB_KEY           = ""

# ── DATABASE ──────────────────────────────────────────────────
SUPABASE_URL        = ""   # e.g. https://xxxx.supabase.co
SUPABASE_KEY        = ""   # anon/public key

# ── EMAIL REPORTS ─────────────────────────────────────────────
EMAILJS_PUBLIC_KEY  = ""
EMAILJS_SERVICE_ID  = ""
EMAILJS_TEMPLATE_ID = ""

# ── NOTIFICATIONS ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN  = ""
TELEGRAM_CHAT_ID    = ""

# ── ADDITIONAL VISION / UTILITY ───────────────────────────────
HUGGINGFACE_API_KEY = ""
OCRSPACE_API_KEY    = "helloworld"   # free test key works out of the box
UNSPLASH_API_KEY    = ""
CLARIFAI_PAT        = ""
DEEPL_API_KEY       = ""
JSONBIN_MASTER_KEY  = ""
